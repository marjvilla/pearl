            <property name="styleSheet">
             <string notr="true">/* 1. Target the box border and height */
QScrollArea#scrollForPatientNames {
    border: 4px solid #1e88e5 !important;
    border-radius: 12px;
    min-height: 300px !important;
}

/* 2. Target ANY label that appears inside that scroll area */
#scrollForPatientNames QLabel {
    font-size: 38px !important;
    font-weight: bold !important;
    color: #1e88e5 !important;
    padding: 12px !important;
    min-height: 50px !important; /* This forces the row to be tall */
    background-color: white;
    border-bottom: 2px solid #dcdcdc;
}</string>
