    border: 2px solid #1e88e5;
    border-radius: 8px;    /* Softer, more modern edges */
    background: white;
}

/* Increase the size of the up/down arrows */
QSpinBox::up-button, QSpinBox::down-button {
    width: 60px;           /* Crucial: Makes the tap target wide */
    background: #e3f2fd;   /* Light blue background */
    border: 1px solid #1e88e5;
    border-radius: 4px;
}

/* Visual feedback when tapped */
QSpinBox::up-button:pressed, QSpinBox::down-button:pressed {
    background: #1e88e5;   /* Darker blue on tap */
}</string>
              </property>
             </widget>
            </item>
